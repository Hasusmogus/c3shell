CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_FREERTOS_CHECK_STACKOVERFLOW_CANARY=y
CONFIG_LWIP_MAX_SOCKETS=10
# Any attempt by running code to write the bootloader, partition table or the
# running firmware's flash is stopped by the flash driver (this is also the
# IDF default; stated here so it can't silently change).
CONFIG_SPI_FLASH_DANGEROUS_WRITE_ABORTS=y
# LittleFS: the vi/cp code writes whole files and renames them into place.
CONFIG_LITTLEFS_USE_MTIME=n
# OpenVPN over UDP: the server's tunnel packets can arrive as IP fragments.
CONFIG_LWIP_IP4_REASSEMBLY=y
# 'top': per-task CPU time and stack use (FreeRTOS run-time stats, esp_timer clock).
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
# Size: features this firmware has no use for.
#  - IPv4 only (every socket here is AF_INET)
CONFIG_LWIP_IPV6=n
#  - 'wifi' joins password (PSK/SAE) networks; WPA2-Enterprise (EAP) and the
#    TLS client it needs are never used
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n
CONFIG_ESP_WIFI_MBEDTLS_TLS_CLIENT=n
#  - the setup network is WPA2-PSK, so the access point needs no WPA3
CONFIG_ESP_WIFI_SOFTAP_SAE_SUPPORT=n
#  - error codes print as numbers instead of names (only seen in a crash report)
CONFIG_ESP_ERR_TO_NAME_LOOKUP=n
# RAM: on the ESP32-C3, code kept in IRAM comes out of the same SRAM as the
# heap. These run from flash instead:
#  - WiFi's speed-ups (~27 KB). The board moves data at SSH speed (tens of
#    KB/s, limited by the crypto), far below what WiFi manages without them.
#  - the heap allocator (~7 KB). Safe: nothing allocates from an interrupt
#    that runs while the flash cache is off.
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_HEAP_PLACE_FUNCTION_INTO_FLASH=y
